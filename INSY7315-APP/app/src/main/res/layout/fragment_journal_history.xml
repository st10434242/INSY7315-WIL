                    <TextView
                        style="@style/Widget.Sgula.Text.TableHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Sat" />

                    <TextView
                        style="@style/Widget.Sgula.Text.TableHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Sun" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_2"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/sgula_space_1"
                        android:background="@drawable/sgula_mood_item_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:padding="@dimen/sgula_space_2"
                        android:text="1"
                        android:textAlignment="center"
                        android:textAppearance="@style/Widget.Sgula.Text.BodySmall" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/sgula_space_1"
                        android:background="@drawable/sgula_mood_item_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:padding="@dimen/sgula_space_2"
                        android:text="2"
                        android:textAlignment="center"
                        android:textAppearance="@style/Widget.Sgula.Text.BodySmall" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/sgula_space_1"
                        android:background="@drawable/sgula_mood_item_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:padding="@dimen/sgula_space_2"
                        android:text="3"
                        android:textAlignment="center"
                        android:textAppearance="@style/Widget.Sgula.Text.BodySmall" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/sgula_space_1"
                        android:background="@drawable/sgula_mood_item_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:padding="@dimen/sgula_space_2"
                        android:text="4"
                        android:textAlignment="center"
                        android:textAppearance="@style/Widget.Sgula.Text.BodySmall" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/sgula_space_1"
                        android:background="@drawable/sgula_mood_item_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:padding="@dimen/sgula_space_2"
                        android:text="5"
                        android:textAlignment="center"
                        android:textAppearance="@style/Widget.Sgula.Text.BodySmall" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/sgula_space_1"
                        android:background="@drawable/sgula_mood_item_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:padding="@dimen/sgula_space_2"
                        android:text="6"
                        android:textAlignment="center"
                        android:textAppearance="@style/Widget.Sgula.Text.BodySmall" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/sgula_space_1"
                        android:background="@drawable/sgula_mood_item_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:padding="@dimen/sgula_space_2"
                        android:text="7"
                        android:textAlignment="center"
                        android:textAppearance="@style/Widget.Sgula.Text.BodySmall" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_1"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/sgula_space_1"
                        android:background="@drawable/sgula_mood_item_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:padding="@dimen/sgula_space_2"
                        android:text="8"
                        android:textAlignment="center"
                        android:textAppearance="@style/Widget.Sgula.Text.BodySmall" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/sgula_space_1"
                        android:background="@drawable/sgula_mood_item_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:padding="@dimen/sgula_space_2"
                        android:text="9"
                        android:textAlignment="center"
                        android:textAppearance="@style/Widget.Sgula.Text.BodySmall" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/sgula_space_1"
                        android:background="@drawable/sgula_mood_item_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:padding="@dimen/sgula_space_2"
                        android:text="10"
                        android:textAlignment="center"
                        android:textAppearance="@style/Widget.Sgula.Text.BodySmall" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/sgula_space_1"
                        android:background="@drawable/sgula_mood_item_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:padding="@dimen/sgula_space_2"
                        android:text="11"
                        android:textAlignment="center"
                        android:textAppearance="@style/Widget.Sgula.Text.BodySmall" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/sgula_space_1"
                        android:background="@drawable/sgula_mood_item_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:padding="@dimen/sgula_space_2"
                        android:text="12"
                        android:textAlignment="center"
                        android:textAppearance="@style/Widget.Sgula.Text.BodySmall" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/sgula_space_1"
                        android:background="@drawable/sgula_mood_item_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:padding="@dimen/sgula_space_2"
                        android:text="13"
                        android:textAlignment="center"
                        android:textAppearance="@style/Widget.Sgula.Text.BodySmall" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_margin="@dimen/sgula_space_1"
                        android:background="@drawable/sgula_mood_item_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:padding="@dimen/sgula_space_2"
                        android:text="14"
                        android:textAlignment="center"
                        android:textAppearance="@style/Widget.Sgula.Text.BodySmall" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Widget.Sgula.Text.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_4"
            android:text="Past entries" />

        <TextView
            style="@style/Widget.Sgula.Text.SectionNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The newest note opens in read mode so you can revisit the full entry without editing it." />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Sgula.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/Widget.Sgula.Text.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today" />

                    <TextView
                        style="@style/Widget.Sgula.StatusBadge.Active"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sgula_space_3"
                        android:text="Open" />
                </LinearLayout>

                <TextView
                    style="@style/Widget.Sgula.Text.CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_2"
                    android:text="A calmer afternoon followed a slower start. I made space to breathe before answering messages, and that changed the whole tone of the day." />

                <TextView
                    style="@style/Widget.Sgula.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_2"
                    android:text="Read mode" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Sgula.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/Widget.Sgula.Text.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mon, 4 Aug" />

                    <TextView
                        style="@style/Widget.Sgula.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sgula_space_3"
                        android:text="Edited" />
                </LinearLayout>

                <TextView
                    style="@style/Widget.Sgula.Text.CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_2"
                    android:text="Wrote after a walk outside. The quiet before dinner felt especially helpful." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Sgula.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/Widget.Sgula.Text.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thu, 1 Aug" />

                    <TextView
                        style="@style/Widget.Sgula.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sgula_space_3"
                        android:text="Draft" />
                </LinearLayout>

                <TextView
                    style="@style/Widget.Sgula.Text.CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_2"
                    android:text="A shorter note about a steady morning, a good coffee, and the first calm moment after a busy meeting." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Sgula.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Sgula.Text.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Read mode preview" />

                <TextView
                    style="@style/Widget.Sgula.Text.CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_2"
                    android:text="When an entry is opened, it becomes a clean reading surface with the original text kept intact." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Sgula.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_4"
            android:text="Back to editor" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
