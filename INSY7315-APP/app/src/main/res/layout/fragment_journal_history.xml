                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_3"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Widget.Sgula.Text.TableHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Mon" />

                    <TextView
                        style="@style/Widget.Sgula.Text.TableHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Tue" />

                    <TextView
                        style="@style/Widget.Sgula.Text.TableHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
